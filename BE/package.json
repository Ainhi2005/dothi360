{
  "name": "backend-su-co-do-thi",
  "version": "0.0.0",
  "private": true,
  "description": "Backend điều phối sự cố đô thị",
  "scripts": {
    "dev": "npm run build && node --watch dist/server.js",
    "build": "tsc && node scripts/copy_database_schema.cjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/common/constants/incident-status.test.js dist/modules/auth/auth.policy.test.js dist/modules/incidents/incident.policy.test.js dist/modules/media/media.validation.test.js dist/config/database-connection.test.js dist/common/hosting/admin-static.test.js",
    "test:integration": "npm run build && node --test --test-concurrency=1 dist/database/p0.integration.test.js dist/modules/notifications/notification.integration.test.js dist/modules/users/user-password.integration.test.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/database/data-source.js",
    "migration:show": "npm run build && typeorm migration:show -d dist/database/data-source.js",
    "seed": "npm run build && node dist/seed.js",
    "wipe:data": "node scripts/wipe_data.js",
    "reset:passwords": "node scripts/reset_passwords.js"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@google/generative-ai": "^0.24.1",
    "argon2": "^0.45.1",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
