# Không đặt secret thật và không commit file .env.
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=su_co_do_thi

# Neon: DATABASE_URL takes precedence over DB_HOST/DB_USER/...; use a DIRECT endpoint.
# DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# DB_SSL=true
# Without DATABASE_URL, local DB_* continues to work without SSL by default.

# Combined hosting on Render; leave false for the current local setup.
SERVE_ADMIN=false
# PUBLIC_APP_URL=https://YOUR_SERVICE.onrender.com

# Tối thiểu 32 ký tự. Production không dùng giá trị mẫu.
JWT_ACCESS_SECRET=replace_with_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_another_32_characters
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=urban-incidents

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Danh sách model thử tiếp theo khi model chính tạm lỗi/không khả dụng.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
AI_ALLOWED_MEDIA_HOSTS=res.cloudinary.com
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Có thể thay bằng Photon tự host khi triển khai production.
GEOCODING_BASE_URL=https://photon.komoot.io
